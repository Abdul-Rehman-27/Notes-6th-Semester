<Window x:Class="Lab_Task3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_Task3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Username:" HorizontalAlignment="Left" Margin="150,100,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="name" Width="200" Height="30" Margin="250,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <Label Content="Password:" HorizontalAlignment="Left" Margin="150,150,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="password" Width="200" Height="30" Margin="250,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <Label Content="Role:" HorizontalAlignment="Left" Margin="150,200,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="listBox" Width="200" Height="100" Margin="250,200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ListBoxItem Content="Admin"/>
            <ListBoxItem Content="Teacher"/>
            <ListBoxItem Content="Student"/>
        </ListBox>

        <Label x:Name="Degree" Content="Degree" HorizontalAlignment="Left" Margin="150,320,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="degreeListBox" Width="200" Height="100" Margin="250,320,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ListBoxItem Content="BSCS"/>
            <ListBoxItem Content="MSCS"/>
            <ListBoxItem Content="PhD"/>
        </ListBox>

    </Grid>
</Window>
