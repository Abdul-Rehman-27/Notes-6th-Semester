<Window x:Class="Combobox_ViaTags.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Combobox_ViaTags"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!--combobox 1-->
        <ComboBox x:Name="cmb1" HorizontalAlignment="Left" Margin="40,50,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cmb1_selectionChanged" IsEditable="True">
            <ComboBoxItem Content="SE"/>
            <ComboBoxItem Content="CS"/>
            <ComboBoxItem Content="AI"/>
        </ComboBox>
        <!--combobox 2-->
        <ComboBox x:Name="cmb2" HorizontalAlignment="Left" Margin="40,150,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cmb2_selectionChanged">
            <ComboBoxItem Content="CN"/>
            <ComboBoxItem Content="DSA"/>
            <ComboBoxItem Content="SQE"/>
        </ComboBox>
        <!--Textbox 1-->
        <TextBox x:Name="tb1" HorizontalAlignment="Left" Margin="250,45,0,0" VerticalAlignment="Top" Width="150" Height="30" TextWrapping="Wrap" />
        <!--Textbox 1-->
        <TextBox x:Name="tb2" HorizontalAlignment="Left" Margin="250,145,0,0" VerticalAlignment="Top" Width="150" Height="30" TextWrapping="Wrap" />
    </Grid>
</Window>