<Window x:Class="CheckBox_InputField.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <CheckBox Content="CheckBox" HorizontalAlignment="Left" Margin="202,103,0,0" VerticalAlignment="Top" Name ="checkBox1" Checked="handleChecked" Unchecked="handleUnchecked"/>
        <CheckBox Content="CheckBox" HorizontalAlignment="Left" Margin="202,152,0,0" VerticalAlignment="Top" x:Name ="checkBox2" IsThreeState="True" Indeterminate="handleThreeState" Checked="handleChecked" Unchecked="handleUnchecked"/>
        <TextBox HorizontalAlignment="Left" Margin="312,102,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" Name="textBox1"/>
        <TextBox HorizontalAlignment="Left" Margin="312,151,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" Name="textBox2"/>


    </Grid>
</Window>