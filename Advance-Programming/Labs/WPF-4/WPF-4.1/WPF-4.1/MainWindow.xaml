<Window x:Class="WPF_4._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_4._1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- First Row: ComboBox and TextBox -->
        <ComboBox Width="100" Height="40" SelectionChanged="cb1" Margin="150,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ComboBoxItem x:Name="item1" Content="item1" Width="100" Height="40"/>
            <ComboBoxItem x:Name="item2" Content="item2" Width="100" Height="40"/>
        </ComboBox>
        <TextBox x:Name="cbt1" Width="200" Height="30" Margin="260,155,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="NoWrap"/>

        <!-- Second Row: ComboBox and TextBox -->
        <ComboBox Width="100" Height="40" SelectionChanged="cb2" Margin="150,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ComboBoxItem x:Name="item11" Content="item1" Width="100" Height="40"/>
            <ComboBoxItem x:Name="item12" Content="item2" Width="100" Height="40"/>
        </ComboBox>
        <TextBox x:Name="cbt2" Width="200" Height="30" Margin="260,255,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="NoWrap" />
    </Grid>
</Window>